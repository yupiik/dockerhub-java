<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.yupiik.internal</groupId>
  <artifactId>java-updater</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <fusion.version>1.2.0</fusion.version>
  </properties>
  <dependencies>
    <dependency><groupId>io.yupiik.fusion</groupId><artifactId>fusion-build-api</artifactId><version>${fusion.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>io.yupiik.fusion</groupId><artifactId>fusion-cli</artifactId><version>${fusion.version}</version></dependency>
    <dependency><groupId>io.yupiik.fusion</groupId><artifactId>fusion-json</artifactId><version>${fusion.version}</version></dependency>
    <dependency><groupId>io.yupiik.fusion</groupId><artifactId>fusion-httpclient</artifactId><version>${fusion.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>6.1.3</version><scope>test</scope></dependency>
    <dependency><groupId>org.snakeyaml</groupId><artifactId>snakeyaml-engine</artifactId><version>2.10</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <finalName>java-updater</finalName>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-clean-plugin</artifactId><version>3.4.1</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.3.1</version></plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version>
        <!-- Shade replaces the main artifact; never reuse its output as the next thin JAR. -->
        <configuration><forceCreation>true</forceCreation></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.1</version>
        <configuration>
          <annotationProcessorPaths>
            <path><groupId>io.yupiik.fusion</groupId><artifactId>fusion-processor</artifactId><version>${fusion.version}</version></path>
            <path><groupId>io.yupiik.fusion</groupId><artifactId>fusion-json</artifactId><version>${fusion.version}</version></path>
            <path><groupId>io.yupiik.fusion</groupId><artifactId>fusion-cli</artifactId><version>${fusion.version}</version></path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.5</version>
        <configuration>
          <excludes><exclude>**/PackagingTest.java</exclude></excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.1</version>
        <dependencies>
          <dependency><groupId>io.yupiik.maven</groupId><artifactId>maven-shade-transformers</artifactId><version>0.0.5</version></dependency>
        </dependencies>
        <executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration>
          <createDependencyReducedPom>false</createDependencyReducedPom>
          <filters>
            <filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.RSA</exclude><exclude>META-INF/*.DSA</exclude></excludes></filter>
            <!-- Keep the application's manifest; dependency manifests do not describe the CLI. -->
            <filter><artifact>io.yupiik.fusion:*</artifact><excludes><exclude>META-INF/MANIFEST.MF</exclude></excludes></filter>
          </filters>
          <transformers>
            <transformer implementation="io.yupiik.maven.shade.transformer.FusionDocumentationTransformer"/>
            <transformer implementation="io.yupiik.maven.shade.transformer.FusionJsonSchemaTransformer"/>
            <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
            <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"><mainClass>io.yupiik.fusion.framework.api.main.Launcher</mainClass></transformer>
          </transformers>
        </configuration></execution></executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>packaging-tests</id>
      <build><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes combine.self="override"><exclude>**/*$*</exclude></excludes>
          <includes><include>**/PackagingTest.java</include></includes>
        </configuration>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>minisite</id>
      <build>
        <plugins>
          <plugin>
            <groupId>io.yupiik.maven</groupId>
            <artifactId>yupiik-tools-maven-plugin</artifactId>
            <version>1.3.1</version>
            <executions>
              <execution><id>documentation</id><phase>prepare-package</phase><goals><goal>minisite</goal></goals></execution>
            </executions>
            <configuration>
              <source>${project.basedir}/src/main/minisite</source>
              <target>${project.build.directory}/minisite</target>
              <title>Java image updater</title>
              <description>Latest Zulu JRE and Alpine images, safely published on two architectures.</description>
              <logoText>Java image updater</logoText>
              <siteBase>/</siteBase>
              <generateIndex>false</generateIndex>
              <generateBlog>false</generateBlog>
              <generateSiteMap>false</generateSiteMap>
              <templateAddLeftMenu>true</templateAddLeftMenu>
              <attributes>
                <minisite-menu-1>/index.html</minisite-menu-1>
                <minisite-menu-1-title>Overview</minisite-menu-1-title>
                <minisite-menu-1-icon>home</minisite-menu-1-icon>
                <minisite-menu-2>/getting-started.html</minisite-menu-2>
                <minisite-menu-2-title>Getting started</minisite-menu-2-title>
                <minisite-menu-2-icon>play</minisite-menu-2-icon>
                <minisite-menu-3>/flow.html</minisite-menu-3>
                <minisite-menu-3-title>Release flow</minisite-menu-3-title>
                <minisite-menu-3-icon>project-diagram</minisite-menu-3-icon>
                <minisite-menu-4>/permissions.html</minisite-menu-4>
                <minisite-menu-4-title>Permissions and tokens</minisite-menu-4-title>
                <minisite-menu-4-icon>lock</minisite-menu-4-icon>
              </attributes>
              <injectYupiikTemplateExtensionPoints>false</injectYupiikTemplateExtensionPoints>
              <customHead><![CDATA[<link rel="stylesheet" href="css/updater.css">]]></customHead>
              <customScripts><![CDATA[<script src="https://cdn.jsdelivr.net/npm/mermaid@11.12.2/dist/mermaid.min.js"></script><script src="js/diagrams.js"></script>]]></customScripts>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
